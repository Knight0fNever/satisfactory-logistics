# Copy to .env and fill in your Supabase project values.
# .env is gitignored. Never commit real credentials.
# These prefixed values are exposed to the browser bundle by Vite (this is
# fine for the anon key, which is designed to be public when paired with RLS).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional: project ref used by `npm run supabase:types` if you prefer it
# over `--linked`. Leave unset if you have already run `supabase link`.
# SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
